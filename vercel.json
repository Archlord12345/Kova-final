{
  "version": 2,
  "installCommand": "npm ci --prefix server",
  "buildCommand": "echo 'KOVA backend: no build step required'",
  "builds": [
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/src/index.js"
    }
  ]
}
